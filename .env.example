# Google Analytics 4 measurement ID
VITE_GA_MEASUREMENT_ID=G-PXRM4N9YSH

# Formspree form ID for coach interest (https://formspree.io)
# Create a form that delivers to henrik@caseloidrottsmedicin.se, then paste the id.
# Example: xyzabcde  → posts to https://formspree.io/f/xyzabcde
VITE_FORMSPREE_FORM_ID=

# --- Erbjudanden / Swish och bankgiro (server-side, do not prefix with VITE_) ---
# Swish- och bankgironumret ligger i koden (OFFER_SWISH_NUMBER och OFFER_BANKGIRO_NUMBER
# i src/data/erbjudanden.ts) och behöver inte ställas in här.
# Valfritt: ange ett annat nummer här för att ersätta det i koden. Ett felskrivet nummer ignoreras.
OFFERS_SWISH_NUMBER=
OFFERS_BANKGIRO_NUMBER=
# Formspree form that receives new orders. Can reuse the coach form id if the inbox should be the same.
FORMSPREE_ORDERS_FORM_ID=
# Optional override. Defaults to henrik@caseloidrottsmedicin.se
OFFERS_NOTIFY_EMAIL=
# Set to false to disable new purchases before the sales end date.
OFFERS_SALES_ENABLED=true
# Local JSON store is used automatically in development. Set 1 in production only if a writable disk exists.
# OFFERS_LOCAL_STORE=1

# Kaddio booking links for /erbjudanden/boka (leave empty to show contact fallback)
VITE_KADDIO_SNABBHET_FORSTA=
VITE_KADDIO_SNABBHET_ATERTEST=
VITE_KADDIO_FRISKVARD=
